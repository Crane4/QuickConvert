Windows Registry Editor Version 5.00

; Remove old key if exists
[-HKEY_CLASSES_ROOT\*\shell\QuickConvert]

; Register for all image types via SystemFileAssociations
[HKEY_CLASSES_ROOT\SystemFileAssociations\image\shell\QuickConvert]
"MUIVerb"="Quick Convert"
"Icon"="logo.ico"
"SubCommands"=""
"ExplorerCommandHandler"="{BF5E6C7D-8B9A-4E3D-BC1F-2E4D3C2B1A0F}"

